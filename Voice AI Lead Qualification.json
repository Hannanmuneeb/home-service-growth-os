    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You extract structured lead-qualification data from a sales call. Respond with ONLY a JSON object with exactly these keys: is_qualified (boolean), requested_portfolio (boolean), lead_score (integer 0-100 reflecting how hot the lead is).\" },\n    { \"role\": \"user\", \"content\": \"Call summary: \" + ($(\"Summarize Transcript\").item.json.choices[0].message.content || \"\") + \"\\n\\nFull transcript: \" + ($(\"Vapi Call Completed\").item.json.body.message.transcript || \"\") }\n  ]\n} }}",
        "options": {}
      },
      "id": "129b597b-197a-40f4-a577-c845ba7cc3f1",
      "name": "Extract Qualification JSON",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        448,
        320
      ],
      "credentials": {
        "groqApi": {
          "id": "djnQAd5SWGlZcqbk",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse Groq structured JSON into clean fields\nconst content = ($json.choices && $json.choices[0] && $json.choices[0].message && $json.choices[0].message.content) || '';\nlet parsed = {};\ntry {\n  parsed = JSON.parse(content);\n} catch (e) {\n  const m = String(content).match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { parsed = JSON.parse(m[0]); } catch (_) {} }\n}\n\nlet score = Number(parsed.lead_score);\nif (isNaN(score)) score = 0;\nscore = Math.max(0, Math.min(100, Math.round(score)));\n\nconst toBool = (v) => v === true || String(v).toLowerCase() === 'true';\n\nconst call = ($('Vapi Call Completed').item.json.body && $('Vapi Call Completed').item.json.body.message && $('Vapi Call Completed').item.json.body.message.call) || {};\nconst customer = call.customer || {};\nconst metadata = call.metadata || {};\n\nconst summary = ($('Summarize Transcript').item.json.choices && $('Summarize Transcript').item.json.choices[0] && $('Summarize Transcript').item.json.choices[0].message && $('Summarize Transcript').item.json.choices[0].message.content) || '';\nconst transcript = ($('Vapi Call Completed').item.json.body && $('Vapi Call Completed').item.json.body.message && $('Vapi Call Completed').item.json.body.message.transcript) || '';\n\nreturn {\n  is_qualified: toBool(parsed.is_qualified),\n  requested_portfolio: toBool(parsed.requested_portfolio),\n  lead_score: score,\n  lead_temperature: score >= 60 ? 'Hot' : 'Cold',\n  summary,\n  transcript,\n  lead_name: customer.name || metadata.name || '',\n  lead_email: metadata.email || customer.email || '',\n  lead_phone: customer.number || '',\n};"
      },
