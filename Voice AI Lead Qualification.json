        "jsonBody": "={{ {\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0.3,\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You are an assistant that writes concise summaries of outbound sales call transcripts. Summarize the customer's needs, interest level, objections and any next steps in 4-6 sentences.\" },\n    { \"role\": \"user\", \"content\": \"Call transcript:\\n\" + ($json.body.message.transcript || \"No transcript available.\") }\n  ]\n} }}",
        "options": {}
