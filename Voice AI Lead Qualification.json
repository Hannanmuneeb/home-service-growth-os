    {
      "parameters": {
        "jsCode": "// Format incoming phone numbers to E.164, default country code 92 (Pakistan)\nconst DEFAULT_CC = '92';\nconst out = [];\nfor (const entry of $input.all()) {\n  const body = entry.json.body || entry.json;\n  const raw = String(body.phone == null ? '' : body.phone).trim();\n  let e164 = '';\n  if (raw) {\n    if (raw.trim().startsWith('+')) {\n      e164 = '+' + raw.replace(/\\D/g, '');\n    } else {\n      let digits = raw.replace(/\\D/g, '');\n      if (digits.startsWith('00')) {\n        e164 = '+' + digits.slice(2);\n      } else if (digits.startsWith('0')) {\n        e164 = '+' + DEFAULT_CC + digits.slice(1);\n      } else if (digits.startsWith(DEFAULT_CC)) {\n        e164 = '+' + digits;\n      } else {\n        e164 = '+' + DEFAULT_CC + digits;\n      }\n    }\n  }\n  out.push({\n    json: {\n      name: body.name || '',\n      email: body.email || '',\n      phone_raw: raw,\n      phone: e164,\n      timestamp: new Date().toISOString()\n    },\n  });\n}\nreturn out;"
      },
